# Kâtip policy gateway – local development (never commit a real .env)
PORT=8080
LITELLM_BASE_URL=http://localhost:4010/v1   # mock-llm locally; http://litellm:4000/v1 in compose
LITELLM_API_KEY=dev-only-not-a-secret
# Postgres + Valkey (P1-02): tenants/users/keys from the governance DB, auth cache in Valkey
DATABASE_URL=postgres://katip:katip@localhost:5432/governance
VALKEY_URL=redis://localhost:6379
# DEV ONLY alternative to DATABASE_URL: JSON file with tenants (SHA-256 keys)
# DEV_TENANTS_FILE=./dev-tenants.example.json  # demo key: sk-katip-demo-local
LOG_LEVEL=info
