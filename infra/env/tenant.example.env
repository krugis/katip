# Tenant env template — rendered per tenant by the bootstrap from
# infra/env/katip.env + katip.config.yaml. LibreChat container env.
# Meili/Mongo point at platform services with per-tenant names.

# --- LibreChat core ---
HOST=0.0.0.0
PORT=3080
APP_TITLE=SME AI (${KATIP_SLUG})
DOMAIN_CLIENT=https://${KATIP_SLUG}.${KATIP_BASE_DOMAIN}
DOMAIN_SERVER=https://${KATIP_SLUG}.${KATIP_BASE_DOMAIN}

# --- LibreChat internal secrets (auto-generated by the bootstrap) ---
CREDS_KEY=${KATIP_LC_CREDS_KEY}
CREDS_IV=${KATIP_LC_CREDS_IV}
JWT_SECRET=${KATIP_LC_JWT_SECRET}
JWT_REFRESH_SECRET=${KATIP_LC_JWT_REFRESH_SECRET}

# --- MongoDB (platform mongo, per-tenant db) ---
MONGO_URI=mongodb://katip:${KATIP_MONGO_PASSWORD}@mongodb:27017/lc_${KATIP_SLUG}?authSource=admin

# --- Meilisearch (platform meili, per-tenant index prefix) ---
SEARCH=true
SEARCH_ENABLED=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=${KATIP_MEILI_MASTER_KEY}
SEARCH_METHODS=hybrid

# --- Files ---
# Local file storage (S3/SeaweedFS arrives with P1-35)
FILES_UPLOAD_DIR=/app/uploads

# --- RAG (P1-08): embeddings via the gateway ---
# RAG_API_URL=http://rag-api:8000

# --- Auth: Keycloak OIDC only (LLD-02 §2): MFA is enforced by Keycloak ---
# LibreChat's default of 7 hits per IP per 5 min on /oauth/* would lock out a company
# behind one office IP after 3 or 4 logins. Keycloak guards passwords itself.
LOGIN_MAX=300
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
OPENID_ISSUER=https://auth.${KATIP_BASE_DOMAIN}/realms/${KATIP_REALM}
OPENID_CLIENT_ID=lc-${KATIP_SLUG}
OPENID_CLIENT_SECRET=${KATIP_LC_OIDC_CLIENT_SECRET}
OPENID_SESSION_SECRET=${KATIP_LC_OIDC_SESSION_SECRET}
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_REQUIRED_ROLE=member
OPENID_REQUIRED_ROLE_TOKEN_KIND=access
OPENID_REQUIRED_ROLE_PARAMETER_PATH=resource_access.lc-${KATIP_SLUG}.roles
OPENID_USE_END_SESSION_ENDPOINT=true
OPENID_BUTTON_LABEL="Giriş yap / Sign in"
# Dev: trust the self-signed certificate on Keycloak's public URL.
NODE_EXTRA_CA_CERTS=/certs/dev-ca.crt
