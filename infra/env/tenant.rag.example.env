# RAG API env template (P1-08), rendered per tenant by the bootstrap to
# infra/env/tenants/<slug>.rag.env. LibreChat's file search uses this service.

# LibreChat signs its calls with its own JWT_SECRET, and this checks them. The service holds
# one secret, which is why each tenant has its own (LLD-08 §1).
JWT_SECRET=${KATIP_LC_JWT_SECRET}

# --- Embeddings: through the gateway, on a key that can do nothing else (LLD-03 §1.3) ---
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=${KATIP_EMBEDDING_MODEL}
RAG_OPENAI_API_KEY=${KATIP_RAG_GATEWAY_KEY}
RAG_OPENAI_BASEURL=http://policy-gateway:8080/v1
# By default it sends token ids, which the gateway refuses: they can't be checked for personal data.
RAG_CHECK_EMBEDDING_CTX_LENGTH=False

# --- Load on the shared name check: one call at a time per file, and few chunks per call ---
PARALLEL_EXECUTION=1
EMBEDDINGS_CHUNK_SIZE=32
EMBEDDING_BATCH_SIZE=64
RAG_THREAD_POOL_SIZE=2

# --- Vectors: this tenant's own Postgres ---
VECTOR_DB_TYPE=pgvector
DB_HOST=ragdb-${KATIP_SLUG}
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=${KATIP_RAG_DB_PASSWORD}
COLLECTION_NAME=files

# The image sets SCARF_NO_ANALYTICS. This covers the other libraries in it.
DO_NOT_TRACK=true
