# ==============================================================================
# Kâtip secrets & keys — TEMPLATE. Copy nothing: `pnpm dev:up` generates
# infra/env/katip.env from this template and fills every AUTO value with a
# random secret. Existing values are NEVER overwritten on re-run.
#
# This file is for local/dev use. Production hosts use SOPS-encrypted
# *.enc.env files (LLD-01 §5, tracker P0-06).
#
#   AUTO  = generated by the bootstrap (random, kept stable across re-runs)
#   SET   = required from you (real provider keys are optional in dev)
#   OPT   = optional; empty = feature disabled
# ==============================================================================

# ---- platform ---------------------------------------------------------------
POSTGRES_USER=katip
POSTGRES_PASSWORD=AUTO
KATIP_GATEWAY_DB_PASSWORD=AUTO   # the gateway's own role, bound by row-level security
KATIP_CONSOLE_DB_PASSWORD=AUTO   # the console API's own role, bound by row-level security
KATIP_PROVIDER_DB_PASSWORD=AUTO  # the provisioner's role
KATIP_IDENTITY_TOKEN=AUTO        # console-api's key to the internal identity service
KATIP_PROVISIONER_KC_SECRET=AUTO # its Keycloak service account, limited to our realm
KC_DB_PASSWORD=AUTO              # keycloak database owner password
LITELLM_DB_PASSWORD=AUTO         # litellm database owner password
KC_BOOTSTRAP_ADMIN_USER=katip-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=AUTO
VALKEY_PASSWORD=AUTO
MONGO_USER=katip
MONGO_PASSWORD=AUTO
LITELLM_MASTER_KEY=AUTO
LITELLM_DATABASE_URL=AUTO        # rendered from POSTGRES_* into postgres DSN
MOCK_LLM_KEY=AUTO                # key the LiteLLM mock entries use upstream
KATIP_PII_TOKEN_KEY=AUTO         # secret behind conversation placeholders
KATIP_METRICS_TOKEN=AUTO         # what Prometheus sends to the gateway and console-api

# ---- monitoring (P1-43) -----------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=AUTO      # Grafana's katip-admin, on http://127.0.0.1:3000; set at its first start
KATIP_MONITOR_DB_PASSWORD=AUTO   # katip_monitor in Postgres: statistics only (Postgres exporter)
KATIP_MONITOR_MONGO_PASSWORD=AUTO  # katip_monitor in Mongo: clusterMonitor only (Mongo exporter)
KATIP_MONITOR_VALKEY_PASSWORD=AUTO # Valkey's katip-monitor user: INFO only (Valkey exporter)

# ---- billing: Lago and billing-bridge (P1-36/P1-37) --------------------------
KATIP_BILLING_DB_PASSWORD=AUTO   # billing-bridge's role, bound by row-level security
LAGO_API_KEY=AUTO                # billing-bridge's key to Lago's API, set in Lago at its start
LAGO_DB_PASSWORD=AUTO            # Lago's own Postgres
LAGO_REDIS_PASSWORD=AUTO         # Lago's own Valkey
LAGO_ADMIN_PASSWORD=AUTO         # Lago's user billing@<base_domain>; its UI isn't deployed
LAGO_SECRET_KEY_BASE=AUTO        # Rails' secret
LAGO_RSA_PRIVATE_KEY=AUTO        # signs Lago's login tokens: an RSA key, base64
LAGO_ENCRYPTION_PRIMARY_KEY=AUTO # Lago encrypts some columns with these three
LAGO_ENCRYPTION_DETERMINISTIC_KEY=AUTO
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=AUTO

# ---- LLM providers (OPT — dev works fully on the mock; fill to use real) ----
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GCP_PROJECT=
GCP_VERTEX_KEY=
VLLM_TR_KEY=                     # phase-3 KVKK region only

# ---- a real model on this machine, for testing (optional) -----------------------------
# host:port of an OpenAI-compatible server, such as llama.cpp at 127.0.0.1:8080. Models with
# no key above then use it, instead of the mock. Then run pnpm dev:up and pnpm test:local-llm.
KATIP_LOCAL_LLM_UPSTREAM=
# Its API key, if it has one.
KATIP_LOCAL_LLM_KEY=
