# ==============================================================================
# Kâtip secrets & keys — TEMPLATE. Copy nothing: `pnpm dev:up` generates
# infra/env/katip.env from this template and fills every AUTO value with a
# random secret. Existing values are NEVER overwritten on re-run.
#
# This file is for local/dev use. Production hosts use SOPS-encrypted
# *.enc.env files (LLD-01 §5, tracker P0-06).
#
#   AUTO  = generated by the bootstrap (random, kept stable across re-runs)
#   SET   = required from you (real provider keys are optional in dev)
#   OPT   = optional; empty = feature disabled
# ==============================================================================

# ---- platform ---------------------------------------------------------------
POSTGRES_USER=katip
POSTGRES_PASSWORD=AUTO
KC_DB_PASSWORD=AUTO              # keycloak database owner password
LITELLM_DB_PASSWORD=AUTO         # litellm database owner password
KC_BOOTSTRAP_ADMIN_USER=katip-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=AUTO
MONGO_USER=katip
MONGO_PASSWORD=AUTO
MEILI_MASTER_KEY=AUTO
LITELLM_MASTER_KEY=AUTO
LITELLM_DATABASE_URL=AUTO        # rendered from POSTGRES_* into postgres DSN
MOCK_LLM_KEY=AUTO                # key the LiteLLM mock entries use upstream

# ---- demo tenant ------------------------------------------------------------
KATIP_DEMO_GATEWAY_KEY=AUTO      # policy-gateway bearer key for tenant "demo"

# ---- LibreChat internal secrets (demo tenant container) ---------------------
KATIP_LC_CREDS_KEY=AUTO          # 32-char hex
KATIP_LC_CREDS_IV=AUTO           # 32-char hex
KATIP_LC_JWT_SECRET=AUTO
KATIP_LC_JWT_REFRESH_SECRET=AUTO

# ---- LLM providers (OPT — dev works fully on the mock; fill to use real) ----
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GCP_PROJECT=
GCP_VERTEX_KEY=
VLLM_TR_KEY=                     # phase-3 KVKK region only
