{
  "name": "katip",
  "private": true,
  "description": "Kâtip – open-source AI workspace for SMEs with a governed LLM router",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:setup": "vitest run --dir scripts/setup",
    "db:generate": "turbo run db:generate --filter=@katip/db",
    "db:migrate": "pnpm --filter @katip/db db:migrate",
    "db:seed": "pnpm --filter @katip/db db:seed",
    "spdx:check": "node scripts/check-spdx.mjs",
    "secrets:check": "secretlint \"**/*\"",
    "licenses:check": "node scripts/check-licenses.mjs",
    "dev:up": "node scripts/setup/main.mjs up",
    "dev:down": "node scripts/setup/main.mjs down",
    "dev:status": "node scripts/setup/main.mjs status",
    "dev:rollback": "node scripts/setup/main.mjs rollback",
    "tenant:create": "node scripts/setup/tenant-cli.mjs create",
    "tenant:suspend": "node scripts/setup/tenant-cli.mjs suspend",
    "tenant:resume": "node scripts/setup/tenant-cli.mjs resume",
    "tenant:delete": "node scripts/setup/tenant-cli.mjs delete",
    "tenant:purge-due": "node scripts/setup/tenant-cli.mjs purge-due",
    "tenant:forget-due": "node scripts/setup/tenant-cli.mjs forget-due",
    "tenant:upgrade": "node scripts/setup/tenant-cli.mjs upgrade",
    "test:lifecycle": "node scripts/setup/lifecycle-e2e.mjs",
    "test:users": "node scripts/setup/users-e2e.mjs",
    "test:pii-names": "node scripts/setup/pii-names.mjs",
    "test:local-llm": "node scripts/setup/local-llm-check.mjs",
    "test:console": "NODE_EXTRA_CA_CERTS=infra/traefik/dev-certs/localhost.crt node apps/console/e2e/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "9.3.4",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "secretlint": "9.3.4",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "3.2.7"
  }
}
